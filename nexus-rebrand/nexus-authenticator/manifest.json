{
  "manifest_version": 3,
  "name": "Nexus Authenticator",
  "version": "1.0.0",
  "description": "Two-factor codes on your Mac, compatible with Google Authenticator. Scan QR codes from anywhere on screen, import and export.",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nexus Authenticator",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "commands": {
    "scan-screen": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "Select a QR code on the page to scan"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
