{
  "manifest_version": 3,
  "name": "Chat with Nexus",
  "version": "1.5.0",
  "description": "An AI sidebar for Nexus. Chat with your own API key (Claude, ChatGPT, Gemini, NVIDIA and many more), or open ChatGPT, Gemini and Claude in their own windows.",
  "key": "",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "Chat with Nexus",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "launcher.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "declarativeNetRequest",
    "cookies"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://chatgpt.com/*",
    "https://*.openai.com/*",
    "https://gemini.google.com/*",
    "https://accounts.google.com/*",
    "https://claude.ai/*",
    "https://copilot.microsoft.com/*",
    "https://login.live.com/*",
    "https://login.microsoftonline.com/*",
    "https://duckduckgo.com/*",
    "https://duck.ai/*",
    "https://*.perplexity.ai/*",
    "https://*.mistral.ai/*",
    "https://integrate.api.nvidia.com/*",
    "https://openrouter.ai/*",
    "https://api.groq.com/*",
    "https://api.deepseek.com/*",
    "https://api.x.ai/*",
    "https://api.together.xyz/*",
    "https://api.cerebras.ai/*",
    "https://api.sambanova.ai/*",
    "https://api.fireworks.ai/*",
    "https://api.deepinfra.com/*",
    "https://api.hyperbolic.xyz/*",
    "https://api.perplexity.ai/*",
    "https://api.moonshot.ai/*",
    "https://api.z.ai/*",
    "https://models.github.ai/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+N",
        "mac": "Alt+Shift+N"
      },
      "description": "Open Chat with Nexus"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
