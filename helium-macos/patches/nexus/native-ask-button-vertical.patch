+void ToolbarView::OnNexusAskButtonPressed() {
+  // Id of the built-in "Chat with Nexus" extension (fixed by the "key" in its manifest.json).
+  static constexpr char kNexusChatExtensionId[] =
+      "iokkgaheigikheidihfidjdkocoaplco";
+  if (SidePanelUI* const side_panel_ui = SidePanelUI::From(browser_.get())) {
+    side_panel_ui->Toggle(
+        SidePanelEntryKey(SidePanelEntryId::kExtension,
+                          extensions::ExtensionId(kNexusChatExtensionId)),
+        SidePanelOpenTrigger::kToolbarButton);
+  }
+}
+
+void ToolbarView::UpdateNexusAskButton() {
+  if (!nexus_ask_button_) {
+    return;
+  }
+  const bool zen_hide = browser_view_->IsZenModeEnabledForLayout() &&
+                        !browser_view_->IsZenModeSideChromePinned();
+  nexus_ask_button_->SetVisible(IsVerticalLayout() &&
+                                nexus_ask_button_shown_.GetValue() &&
+                                !zen_hide);
+}
